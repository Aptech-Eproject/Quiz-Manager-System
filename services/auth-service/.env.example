PORT=5000
NODE_ENV=development

DB_HOST=mysql-db
DB_PORT=3306
DB_NAME=auth_db
DB_USER=auth_user
DB_PASSWORD=auth_pass

# ACCESS TOKEN CONFIG
JWT_ACCESS_SECRET=super_access_secret_key_2024_change_in_production
JWT_ACCESS_EXPIRES=15m

# REFRESH TOKEN CONFIG
JWT_REFRESH_SECRET=super_refresh_secret_key_2024_change_in_production
JWT_REFRESH_EXPIRES=7d

# GOOGLE LOGIN
GOOGLE_CLIENT_ID=replace_with_your_client_id.apps.googleusercontent.com
